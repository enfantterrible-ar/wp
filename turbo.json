{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "start": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
	"clean-dist": {
	  "outputs": []
	},
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint-js": {
      "outputs": []
    },
    "lint-style": {
      "outputs": []
    },
    "format-js": {
      "outputs": []
    }
  }
}
