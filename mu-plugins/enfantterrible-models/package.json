{
  "name": "enfantterrible-models",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run watch",
    "watch": "10up-toolkit watch --port=5010 --hot",
    "build": "10up-toolkit build",
    "format-js": "10up-toolkit format-js",
    "lint-js": "10up-toolkit lint-js",
    "lint-style": "10up-toolkit lint-style",
    "test": "10up-toolkit test-unit-jest --passWithNoTests",
    "clean-dist": "rm -rf ./dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "10up-toolkit": "^6.5.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "dependencies": {
    "@10up/block-components": "^1.21.2",
    "@wordpress/components": "^29.12.0",
    "@wordpress/dom-ready": "^4.26.0",
    "@wordpress/element": "^6.26.0",
    "nanoid": "^5.1.5",
    "prop-types": "^15.7.2"
  },
  "10up-toolkit": {
    "useBlockAssets": true,
    "useScriptModules": true,
    "loadBlockSpecificStyles": true
  }
}
